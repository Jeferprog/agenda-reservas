rules_version = '2';

// ============================================================================
// Regras de segurança do Firestore — Agenda de Visitas (Cresol Cooperar)
//
// IMPORTANTE: estas regras EXIGEM autenticação (request.auth != null).
// O app faz login anônimo (signInAnonymously) no carregamento, então:
//   1) Habilite o provedor "Anônimo" em:
//      Firebase Console > Authentication > Sign-in method > Anônimo > Ativar
//   2) Só publique estas regras DEPOIS de implantar a versão do app que faz
//      login anônimo (já incluída no HTML). Caso contrário o app para de
//      funcionar.
//
// Observação: o login de usuário (com senha) é feito no SERVIDOR (Apps Script)
// e não usa o Firestore. A autenticação anônima aqui serve apenas para liberar
// o acesso a 'places' e 'reservations' (dados não sensíveis) e bloquear acesso
// direto de quem não passa pelo app.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Requisição autenticada (login anônimo do app)
    function signedIn() {
      return request.auth != null;
    }

    // ---- Usuários ----
    // Usuários e senhas foram movidos para uma Planilha Google, acessada
    // apenas pelo servidor (GAS). O navegador NÃO acessa mais esta coleção.
    // ATENÇÃO: após migrar os usuários para a planilha, exclua a coleção
    // 'users' do Firestore (ela contém senhas em texto puro).
    match /users/{userId} {
      allow read, write: if false;
    }

    // ---- Locais / Agências ----
    match /places/{placeId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200;
      allow delete: if signedIn();
    }

    // ---- Reservas / Visitas ----
    match /reservations/{reservationId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.date is string
        && request.resource.data.placeName is string
        && request.resource.data.userName is string;
      allow update, delete: if signedIn();
    }

    // Bloqueia qualquer outra coleção não prevista acima
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
